# Copy this file to .env and fill in your own values. Never commit .env.

# The port the API listens on
PORT=5000

# The frontend address allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Signs login tokens. Use at least 32 random characters. To generate one, run:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts
JWT_EXPIRES_IN=1d

# TEMPORARY until Phase 6: the password for the sample accounts (at least 8 characters)
SEED_USER_PASSWORD=
