# Copy this file to .env and fill in your own values. Never commit .env.

# The port the API listens on
PORT=5000

# The frontend address allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Signs login tokens. Use at least 32 random characters. To generate one, run:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts
JWT_EXPIRES_IN=1d

# PostgreSQL connection, as separate settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minidesk
DB_USER=postgres
DB_PASSWORD=

# Or, on a hosting service, one address instead of the DB_ settings above
# DATABASE_URL=postgres://user:password@host:5432/minidesk

# Set to true if the database requires an encrypted connection, as most hosted ones do
# DB_SSL=true

# Set to 1 when running behind a hosting service's proxy
# TRUST_PROXY=1

# Failed login attempts allowed per address in 15 minutes
# LOGIN_ATTEMPT_LIMIT=10

# Set to production on a real deployment
# NODE_ENV=production
