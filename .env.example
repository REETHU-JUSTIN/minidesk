# Settings for docker-compose.yml. Copy this file to .env in the same folder and fill it in.
# This is separate from backend/.env, which is used when running without Docker.

# The password for the MongoDB container. Use letters and numbers only,
# because it becomes part of a connection address.
MONGO_PASSWORD=

# Signs login tokens. Use at least 32 random characters. To generate one, run:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
